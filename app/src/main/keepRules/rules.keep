# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Shizuku instantiates our privileged UserService below from the main app code;
# its constructor + methods are discovered reflectively by the Shizuku server
# and must not be renamed or stripped anywhere, including in R8-optimized subpackages.
-if class com.dtcgroup.freezer.core.PmUserService
-keep class com.dtcgroup.freezer.core.PmUserService {
    <init>();
    private void <init>(...);
    public *;
}

# AIDL stub classes referenced over a Binder boundary
-keep class com.dtcgroup.freezer.shizuku.IPmService { *; }
-keep class com.dtcgroup.freezer.shizuku.IPmService$* { *; }

# Shizuku provider wiring
-keep class rikka.shizuku.** { *; }